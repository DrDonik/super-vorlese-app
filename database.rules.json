{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": true,
        ".write": true,
        ".validate": "$roomCode.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['page', 'senderId', 'updatedAt'])",
        "page": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "senderId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "members": {
          "$memberId": {
            ".validate": "$memberId.matches(/^[a-z0-9]{1,40}$/) && newData.isNumber() && newData.val() == now"
          }
        },
        "pointers": {
          "$senderId": {
            ".validate": "$senderId.matches(/^[a-z0-9]{1,40}$/) && newData.hasChildren(['x', 'y'])",
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "book": {
          ".validate": "newData.hasChildren(['hash', 'type'])",
          "hash": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "pageCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
          },
          "type": {
            ".validate": "newData.isString() && (newData.val() == 'pdf' || newData.val() == 'photos')"
          },
          "$other": {
            ".validate": false
          }
        },
        "mood": {
          "open": {
            ".validate": "newData.isBoolean()"
          },
          "picks": {
            "$clientId": {
              ".validate": "$clientId.matches(/^[a-z0-9]{1,40}$/)",
              "$iconId": {
                ".validate": "$iconId.matches(/^([1-9]|1[0-9]|20)$/) && newData.isBoolean() && newData.val() == true"
              }
            }
          },
          "lock": {
            ".validate": "newData.hasChildren(['shared', 'at'])",
            "shared": {
              "$iconId": {
                ".validate": "$iconId.matches(/^([1-9]|1[0-9]|20)$/) && newData.isBoolean() && newData.val() == true"
              }
            },
            "personal": {
              "$iconId": {
                ".validate": "$iconId.matches(/^([1-9]|1[0-9]|20)$/) && newData.isBoolean() && newData.val() == true"
              }
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "signal": {
          "$peerId": {
            ".validate": "$peerId.matches(/^[a-z0-9]{1,40}$/)",
            "offer": {
              ".validate": "newData.hasChildren(['sdp', 'from'])",
              "sdp": {
                ".validate": "newData.isString() && newData.val().length <= 100000"
              },
              "from": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$other": {
                ".validate": false
              }
            },
            "answer": {
              ".validate": "newData.hasChildren(['sdp', 'from'])",
              "sdp": {
                ".validate": "newData.isString() && newData.val().length <= 100000"
              },
              "from": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$other": {
                ".validate": false
              }
            },
            "ice": {
              "$candidateId": {
                ".validate": "newData.hasChildren(['from', 'candidate'])",
                "from": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "candidate": {
                  ".validate": "newData.isString() && newData.val().length <= 4000"
                },
                "sdpMid": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "sdpMLineIndex": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
